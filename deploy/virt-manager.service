# Service systemd pour un déploiement permanent (voir docs/DEPLOY.md).
# Installation : sudo cp deploy/virt-manager.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=Virt Manager (API + interface web, libvirt)
After=network.target libvirtd.service
Wants=libvirtd.service

[Service]
User=virtmgr
Group=virtmgr
# Accès à qemu:///system sans root : appartenance au groupe libvirt.
SupplementaryGroups=libvirt
Environment=API_BIND=127.0.0.1:8080
Environment=VIRTMGR_DATA_DIR=/var/lib/virt-manager-app
Environment=VIRTMGR_STATIC_DIR=/opt/virt-manager-app/dist
# Réglages sensibles (mot de passe admin initial, VIRTMGR_COOKIE_SECURE=1 derrière HTTPS…) :
# fichier root:root 0600, facultatif.
EnvironmentFile=-/etc/virt-manager-app.env
ExecStart=/opt/virt-manager-app/virt-manager-api
Restart=on-failure
RestartSec=3

# Durcissement (le service n'écrit que dans son répertoire de données).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/virt-manager-app
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
