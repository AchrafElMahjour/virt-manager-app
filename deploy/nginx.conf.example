# Reverse-proxy HTTPS devant Virt Manager (voir docs/DEPLOY.md).
# Points indispensables :
#  - « Host » doit être transmis tel quel ($http_host, port compris) : le serveur compare l'en-tête
#    Origin du navigateur à Host (protection CSRF) ; sinon toutes les actions répondent 403 ;
#  - les en-têtes Upgrade/Connection permettent la console VNC (WebSocket) ;
#  - pas de limite de taille ni de mise en tampon : les ISO sont envoyées en flux (le serveur
#    applique lui-même sa limite, VIRTMGR_MAX_UPLOAD_GIB).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name vm.example.org;
    ssl_certificate     /etc/ssl/certs/vm.example.org.pem;
    ssl_certificate_key /etc/ssl/private/vm.example.org.key;

    client_max_body_size 0;
    proxy_request_buffering off;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

server {
    listen 80;
    server_name vm.example.org;
    return 301 https://$host$request_uri;
}
